<ui:FluentWindow x:Class="DeepFilterNetGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeepFilterNetGui"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/DeepFilterNetGui;component/Assets/app.ico"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     ShowMaximize="False"
                     ShowMinimize="True"
                     ShowClose="True" />

        <Grid Grid.Row="1" Margin="12,0,12,6" Width="1200" HorizontalAlignment="Center">
            <ui:Card Padding="16" Margin="6">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock FontWeight="SemiBold" Text="输入后端" />
                    <ComboBox ItemsSource="{Binding Backends}"
                              SelectedItem="{Binding SelectedInputBackend}"
                              IsEnabled="{Binding IsNotRunning}"
                              Height="36"
                              VerticalContentAlignment="Center"
                              Padding="6,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock FontWeight="SemiBold" Text="输入设备" />
                    <ComboBox ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedInputDevice}"
                              IsEnabled="{Binding IsNotRunning}"
                              Height="36"
                              VerticalContentAlignment="Center"
                              Padding="6,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock FontWeight="SemiBold" Text="输出后端" />
                    <ComboBox ItemsSource="{Binding Backends}"
                              SelectedItem="{Binding SelectedOutputBackend}"
                              IsEnabled="{Binding IsNotRunning}"
                              Height="36"
                              VerticalContentAlignment="Center"
                              Padding="6,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0">
                    <TextBlock FontWeight="SemiBold" Text="输出设备" />
                    <ComboBox ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice}"
                              IsEnabled="{Binding IsNotRunning}"
                              Height="36"
                              VerticalContentAlignment="Center"
                              Padding="6,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                </Grid>
            </ui:Card>
        </Grid>

        <Grid Grid.Row="2" Margin="12,0,12,6" Width="1200" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0.5*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Height="{Binding ElementName=RightPanel, Path=ActualHeight}" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Padding="14" Margin="6" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="波形" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="#B0B0B0" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="输入 {0:F2}  |  输出 {1:F2}">
                                        <Binding Path="InRms" />
                                        <Binding Path="OutRms" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Border Grid.Row="1" Background="#111111" CornerRadius="8" MinHeight="110">
                            <Image Source="{Binding WaveformImage}" Stretch="Fill" Margin="8" />
                        </Border>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="1" Padding="14" Margin="6,6,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="频谱" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="#B0B0B0" FontSize="12" Text="0–8 kHz" />
                        </Grid>
                        <Border Grid.Row="1" Background="#111111" CornerRadius="8" MinHeight="110">
                            <Image Source="{Binding SpectrumImage}" Stretch="Fill" Margin="8" />
                        </Border>
                    </Grid>
                </ui:Card>
            </Grid>

            <Grid Grid.Column="1" x:Name="RightPanel" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Padding="14" Margin="6" VerticalAlignment="Top">
                    <StackPanel>
                        <ui:Button Height="58"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding ToggleCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Content" Value="开始" />
                                    <Setter Property="Icon" Value="{ui:SymbolIcon Play24}" />
                                    <Setter Property="Appearance" Value="Success" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Content" Value="停止" />
                                            <Setter Property="Icon" Value="{ui:SymbolIcon Stop24}" />
                                            <Setter Property="Appearance" Value="Danger" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <TextBlock FontWeight="SemiBold" Text="状态" Margin="0,12,0,0" />
                        <Border Margin="0,4,0,0" CornerRadius="20" Padding="12,7" HorizontalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1B1B1B" />
                                    <Setter Property="BorderBrush" Value="#2A2A2A" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="#123320" />
                                            <Setter Property="BorderBrush" Value="#1E5A34" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF6B6B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#3DDC84" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFD6D6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="#CFF6DD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock FontWeight="SemiBold" Text="降噪强度" Margin="0,12,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    Value="{Binding DenoiseStrengthDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Height="28" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#B0B0B0"
                                       Text="{Binding DenoiseStrengthDb, StringFormat={}{0:F0} dB}" />
                        </Grid>
                        <TextBlock FontWeight="SemiBold" Text="后滤波强度(beta)" Margin="0,10,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0"
                                    Maximum="0.05"
                                    SmallChange="0.001"
                                    LargeChange="0.005"
                                    Value="{Binding PostFilterBeta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Height="28" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#B0B0B0"
                                       Text="{Binding PostFilterBeta, StringFormat={}{0:F3}}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

            <ui:Card Grid.Row="1" Padding="16" Margin="6,6,6,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="性能" />
                    <TextBlock Foreground="#B0B0B0" FontSize="12" Margin="0,2,0,12" Text="实时推理指标" />

                    <Border CornerRadius="10" Background="#161616" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Foreground="#B0B0B0" FontSize="12" Text="RTF" />
                            <TextBlock Text="{Binding Rtf, StringFormat={}{0:F3}}"
                                       FontSize="28"
                                       FontFamily="Bahnschrift"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Background="#151515" Padding="10" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Foreground="#B0B0B0" FontSize="12" Text="帧耗时" />
                                <TextBlock Text="{Binding FrameMs, StringFormat={}{0:F2} ms}"
                                           FontFamily="Bahnschrift"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Background="#151515" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Foreground="#B0B0B0" FontSize="12" Text="推理耗时" />
                                <TextBlock Text="{Binding InferMs, StringFormat={}{0:F2} ms}"
                                           FontFamily="Bahnschrift"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Background="#151515" Padding="10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Foreground="#B0B0B0" FontSize="12" Text="输入采样率" />
                                <TextBlock Text="{Binding InputSampleRateDisplay}"
                                           FontFamily="Bahnschrift"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Background="#151515" Padding="10">
                            <StackPanel>
                                <TextBlock Foreground="#B0B0B0" FontSize="12" Text="输出采样率" />
                                <TextBlock Text="{Binding OutputSampleRateDisplay}"
                                           FontFamily="Bahnschrift"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="8" Background="#151515" Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Foreground="#B0B0B0" FontSize="12" Text="处理通道" />
                                <TextBlock Text="{Binding ProcessingChannelMode}"
                                           FontFamily="Bahnschrift"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </Grid>

        <tray:NotifyIcon x:Name="TrayIcon"
                         FocusOnLeftClick="False"
                         MenuOnRightClick="True"
                         TooltipText="DeepFilterNet3"
                         Icon="pack://application:,,,/DeepFilterNetGui;component/Assets/app.png"
                         LeftClick="OnTrayLeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu BorderThickness="0" BorderBrush="Transparent">
                    <MenuItem Header="打开主界面" Click="OnTrayOpenClick" />
                    <MenuItem Header="设置" Click="OnTraySettingsClick" />
                    <Separator />
                    <MenuItem Header="退出" Click="OnTrayExitClick" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

    </Grid>
</ui:FluentWindow>

