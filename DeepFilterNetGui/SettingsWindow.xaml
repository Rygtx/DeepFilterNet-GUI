<ui:FluentWindow x:Class="DeepFilterNetGui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="设置"
        Width="680"
        MinWidth="680"
        MaxWidth="680"
        MaxHeight="760"
        SizeToContent="Height"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="设置"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="True" />

        <ui:Card Grid.Row="1" Margin="16,8,16,16" Padding="0">
            <TabControl>
                <TabItem Header="常规">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="输出日志到文件" />
                                    <TextBlock Foreground="#9E9E9E" FontSize="12" Text="写入 logs/deepfilternet3-*.log" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="FileLogToggle"
                                                 Grid.Column="1"
                                                 OnContent="开"
                                                 OffContent="关"
                                                 VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="开启自启动" />
                                    <TextBlock Foreground="#9E9E9E" FontSize="12" Text="随系统启动运行程序" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="AutoStartToggle"
                                                 Grid.Column="1"
                                                 OnContent="开"
                                                 OffContent="关"
                                                 VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="最小化到托盘" />
                                    <TextBlock Foreground="#9E9E9E" FontSize="12" Text="窗口最小化时隐藏到托盘" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="MinimizeToTrayToggle"
                                                 Grid.Column="1"
                                                 OnContent="开"
                                                 OffContent="关"
                                                 VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="关闭到托盘" />
                                    <TextBlock Foreground="#9E9E9E" FontSize="12" Text="点击关闭按钮时隐藏到托盘" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="CloseToTrayToggle"
                                                 Grid.Column="1"
                                                 OnContent="开"
                                                 OffContent="关"
                                                 VerticalAlignment="Center" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="启动到托盘" />
                                    <TextBlock Foreground="#9E9E9E" FontSize="12" Text="程序启动后直接隐藏到托盘" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="StartToTrayToggle"
                                                 Grid.Column="1"
                                                 OnContent="开"
                                                 OffContent="关"
                                                 VerticalAlignment="Center" />
                            </Grid>

                            <Separator Margin="0,12,0,8" />
                            <TextBlock x:Name="VersionText"
                                       Foreground="#9E9E9E"
                                       FontSize="12"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="音频">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="采样率" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="AudioSampleRateCombo" Width="180" />
                                    <TextBlock Text="Hz" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#9E9E9E" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通道掩码合并" />
                                <ComboBox x:Name="ReduceMaskCombo"
                                          Grid.Column="1"
                                          Width="180" />
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </ui:Card>
    </Grid>
</ui:FluentWindow>

