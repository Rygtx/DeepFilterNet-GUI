<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2026.4.2.1</Version>
    <RootNamespace>DeepFilterNetGui</RootNamespace>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPublish)'=='true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <NativeBridgeName>deepfilter_runtime_bridge</NativeBridgeName>
    <RustBridgeManifest>$(MSBuildProjectDirectory)\..\rust\deepfilter_runtime_bridge\Cargo.toml</RustBridgeManifest>
    <RustTargetTriple>x86_64-pc-windows-msvc</RustTargetTriple>
    <CargoProfile Condition="'$(Configuration)'=='Release'">release</CargoProfile>
    <CargoProfile Condition="'$(Configuration)'!='Release'">debug</CargoProfile>
    <CargoArguments Condition="'$(Configuration)'=='Release'">build --manifest-path &quot;$(RustBridgeManifest)&quot; --target $(RustTargetTriple) --locked --release</CargoArguments>
    <CargoArguments Condition="'$(Configuration)'!='Release'">build --manifest-path &quot;$(RustBridgeManifest)&quot; --target $(RustTargetTriple) --locked</CargoArguments>
    <NativeBridgeOutputPath>$(MSBuildProjectDirectory)\..\rust\deepfilter_runtime_bridge\target\$(RustTargetTriple)\$(CargoProfile)\$(NativeBridgeName).dll</NativeBridgeOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.2.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <Target Name="BuildNativeBridge" BeforeTargets="BeforeBuild">
    <Exec Command="cargo $(CargoArguments)" />
    <Copy SourceFiles="$(NativeBridgeOutputPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeBridgeToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(NativeBridgeOutputPath)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
